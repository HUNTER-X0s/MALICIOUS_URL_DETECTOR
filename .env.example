# =================================================================
# URLSentinel Production Environment Variables Template
# =================================================================

# Server & Security
SECRET_KEY=generate-at-least-32-random-alphanumeric-characters-here
DEBUG=false
LOG_LEVEL=INFO

# Application URLs
NEXT_PUBLIC_API_URL=https://urlsentinel.io/api/v1
ALLOWED_ORIGINS=["https://urlsentinel.io","https://www.urlsentinel.io","chrome-extension://*"]

# Persistence
POSTGRES_DB=urlsentinel
POSTGRES_USER=urlsentinel
POSTGRES_PASSWORD=replace-with-secure-strong-database-password
DATABASE_URL=postgresql+asyncpg://urlsentinel:replace-with-secure-strong-database-password@postgres:5432/urlsentinel

# Redis Persistent Cache
REDIS_PASSWORD=replace-with-secure-strong-redis-password
REDIS_URL=redis://:replace-with-secure-strong-redis-password@redis:6379/0
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=86400

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_URL_LENGTH=2048

# Threat Feed Sync
FEED_REFRESH_INTERVAL_MINUTES=15
FEED_TIMEOUT_SECONDS=10.0
